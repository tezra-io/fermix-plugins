{
  "schema_version": 2,
  "name": "hackernews",
  "display_name": "Hacker News",
  "description": "Search Hacker News stories and read the current front page via the Algolia HN Search API.",
  "category": "news",
  "version": "0.1.0",
  "plugin_api": 2,
  "min_core_version": "0.2.3",
  "interface": {
    "short_description": "Hacker News search and front page",
    "developer_name": "Fermix"
  },
  "auth": {
    "type": "none"
  },
  "tools": [
    {
      "name": "hackernews_search_stories",
      "description": "Search Hacker News stories by keyword via the Algolia HN Search API.",
      "policy_class": "external_api",
      "read_only": true,
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search terms matched against story titles and URLs."
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "description": "Maximum number of stories to return (1-50)."
          }
        },
        "required": ["query"]
      },
      "request": {
        "method": "GET",
        "url": "https://hn.algolia.com/api/v1/search",
        "query": {
          "query": "{query}",
          "tags": "story",
          "hitsPerPage": "{limit}"
        },
        "success": [200]
      },
      "extract": {
        "path": "hits[*]",
        "fields": [
          "title",
          "url",
          "author",
          "points",
          "num_comments",
          "created_at",
          "objectID"
        ]
      }
    },
    {
      "name": "hackernews_front_page",
      "description": "List stories currently on the Hacker News front page.",
      "policy_class": "external_api",
      "read_only": true,
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 30,
            "description": "Maximum number of stories to return."
          }
        }
      },
      "request": {
        "method": "GET",
        "url": "https://hn.algolia.com/api/v1/search",
        "query": {
          "tags": "front_page",
          "hitsPerPage": "{limit}"
        },
        "success": [200]
      },
      "extract": {
        "path": "hits[*]",
        "fields": [
          "title",
          "url",
          "author",
          "points",
          "num_comments",
          "created_at",
          "objectID"
        ]
      }
    }
  ]
}
