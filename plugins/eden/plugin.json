          "limit": {
            "description": "Max hits. Default 10.",
            "maximum": 25,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "Natural-language description of what to find.",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "description": "Restrict social items to one platform.",
            "enum": [
              "youtube",
              "twitter",
              "instagram",
              "tiktok",
              "linkedin",
              "threads",
              "substack"
