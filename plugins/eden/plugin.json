              "maxLength": 64,
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "workspaceId": {
            "description": "Workspace id. Optional when EDEN_WORKSPACE_ID is configured.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
