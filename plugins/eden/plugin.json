            "maxLength": 256
          },
          "type": {
            "description": "Restrict to one item type (e.g. `markdown`, `canvas`, `twitter`, `youtube`, `image`).",
            "type": "string",
            "maxLength": 64
          },
          "parentId": {
            "description": "Restrict to items whose parent board has this id.",
            "type": "string",
            "maxLength": 128
          },
          "limit": {
            "description": "Max results per page. Default 25, max 100.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "description": "Opaque pagination cursor from the previous response's `nextCursor`. Omit on first call.",
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "output_schema": null,
      "upstream_annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "descriptor_sha256": "a6452631feefa076115fafe65413ad8ce85d3229ae7758410145500d305320c0"
    },
    {
      "name": "eden_find_workspace_items",
      "description": "Semantic workspace search. Costs one EdenAI credit per call.",
      "policy_class": "external_api",
      "read_only": true,
      "replay_safe": false,
      "required_credential_scope": "read",
      "rail": "mcp",
      "collection_policy": {
        "paginated": true,
        "request_limit_pointer": "/limit",
        "default_limit": 50,
        "result_items_pointer": "/items",
        "max_returned_items": 50
      },
      "argument_guards": [],
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "workspaceId": {
            "description": "Workspace id. Optional when EDEN_WORKSPACE_ID is configured.",
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Natural-language description of what to find."
          },
          "limit": {
            "description": "Max hits. Default 10.",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "kind": {
            "description": "Restrict to one item kind.",
            "type": "string",
            "enum": [
              "documents",
              "cards",
              "stacks",
              "pdfs",
              "images",
              "videos",
              "audio",
              "links",
              "social"
            ]
          },
          "source": {
            "description": "Restrict social items to one platform.",
            "type": "string",
            "enum": [
              "youtube",
              "twitter",
              "instagram",
              "tiktok",
              "linkedin",
              "threads",
              "substack"
            ]
          },
          "category": {
            "description": "Restrict to one AI category.",
            "type": "string",
            "maxLength": 128
          },
          "tags": {
            "description": "Restrict to items carrying any of these AI tags.",
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "query"
        ]
      },
      "output_schema": null,
      "upstream_annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "descriptor_sha256": "69ba1daadecdd5dbda864c1967c8d018b28623fe7eac7d80ae312bd9651cc42b"
