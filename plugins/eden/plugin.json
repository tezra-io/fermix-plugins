    {
      "name": "eden_create_note",
      "description": "Create a long-form Markdown note. Never an overwrite path.",
      "policy_class": "external_api",
      "read_only": false,
      "replay_safe": false,
      "required_credential_scope": "write",
      "rail": "mcp",
      "collection_policy": null,
      "argument_guards": [],
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "workspaceId": {
            "description": "Workspace id from `eden_list_workspaces`. Optional when EDEN_WORKSPACE_ID is configured.",
            "type": "string",
            "minLength": 1
          },
          "boardId": {
            "description": "Compatibility alias for a board destination. Id of the destination board (item `type: \"canvas\"`, or a folder). Find it via `eden_list_workspace_items` or `eden_search_workspace_items` \u2014 when the user names a board (\"my Hooks board\"), search by title first instead of asking. The authenticated user must have write access to the board.",
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "description": "Explicit Library or board destination. Library creates zero placements.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "library"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "board"
                  },
                  "boardId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "boardId"
                ]
              }
            ]
          },
          "presentation": {
            "description": "\"document\" (default) = an editable Document. \"card\" = a short canvas-visible text Card (sticky).",
            "type": "string",
            "enum": [
              "document",
              "card"
            ]
          },
          "title": {
            "description": "Document title. Omit to derive from the first line of `content`. Ignored for cards.",
            "type": "string",
            "maxLength": 300
          },
          "content": {
            "description": "Full markdown body. Required for cards; max 20K chars in card mode.",
            "type": "string",
            "maxLength": 200000
          },
          "color": {
            "description": "Cards only: optional CSS color value, such as '#fff7a8'. Omit for Eden's default.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "output_schema": null,
      "upstream_annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "descriptor_sha256": "86f0af00b8be2e24c997934fee7c7e40ad510f8f508a418ec19e69ea231bad93"
    },
    {
      "name": "eden_append_to_note",
