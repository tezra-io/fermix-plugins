    {
      "name": "eden_list_highlights",
      "description": "List saved highlights with bounded pagination.",
      "policy_class": "external_api",
      "read_only": true,
      "replay_safe": true,
      "required_credential_scope": "read",
      "rail": "mcp",
      "collection_policy": {
        "paginated": true,
        "request_limit_pointer": "/limit",
        "default_limit": 50,
        "result_items_pointer": "/items",
        "max_returned_items": 50
      },
      "argument_guards": [],
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "limit": {
            "description": "Max highlights per page. Default 20.",
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "description": "Pagination offset. Default 0.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "orderBy": {
            "description": "`recent` = most recently synced (default). `highlighted` = by the date the user highlighted it in the source.",
            "enum": [
              "recent",
              "highlighted"
            ],
            "type": "string"
          },
          "source": {
            "description": "Restrict to one source: substring-matched (case-insensitive) against book/article title and author. Returns every highlight from the matching source(s), newest first.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "workspaceId": {
            "description": "Workspace id from `eden_list_workspaces`, used to resolve each highlight's Library `itemId`. Optional when EDEN_WORKSPACE_ID is configured.",
            "minLength": 1,
            "type": "string"
          }
