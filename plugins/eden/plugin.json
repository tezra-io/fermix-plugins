{
  "schema_version": 2,
  "name": "eden",
  "display_name": "Eden",
  "description": "Your Eden second brain: search, read, capture, and connect knowledge in an Eden workspace.",
  "category": "productivity",
  "version": "1.0.0",
  "interface": {
    "short_description": "Use your Eden second brain from Fermix",
    "developer_name": "Fermix",
    "logo": "assets/logo.svg"
  },
  "auth": {
    "type": "api_key",
    "key_name": "EDEN_PERSONAL_ACCESS_TOKEN",
    "header": "Authorization",
    "scheme": "Bearer",
    "prompt": "Paste an Eden personal access token",
    "help_url": "https://eden.so/help/eden-mcp/installing-with-cli/",
    "validation": {
      "prefix": "eden_pat_",
      "min_bytes": 16,
      "max_bytes": 512,
      "charset": "visible_ascii",
      "forbid_whitespace": true
    }
  },
  "runtime": {
    "kind": "remote_mcp",
    "transport": "streamable_http",
    "protocol_version": "2025-06-18",
    "base_url": "https://mcp.eden.so",
    "mcp_path": "/mcp",
    "tool_name_mode": "preserve"
  },
  "tool_profiles": [
    {
      "name": "retrieval",
      "display_name": "Retrieval only",
      "default": true,
      "required_credential_scope": "read",
      "scope_visibility": "none",
      "tools": [
        "eden_list_workspace_items",
        "eden_search_workspace_items",
        "eden_find_workspace_items",
        "eden_read_board",
        "eden_read_card",
        "eden_read_media_card",
        "eden_read_social_post",
        "eden_get_note_markdown",
        "eden_get_item_connections",
        "eden_get_suggested_connections",
        "eden_search_highlights",
        "eden_list_highlights"
      ]
    },
    {
      "name": "capture",
      "display_name": "Retrieval and capture",
      "default": false,
      "required_credential_scope": "write",
      "scope_visibility": "none",
      "tools": [
        "eden_list_workspace_items",
        "eden_search_workspace_items",
        "eden_find_workspace_items",
        "eden_read_board",
        "eden_read_card",
        "eden_read_media_card",
        "eden_read_social_post",
        "eden_get_note_markdown",
        "eden_get_item_connections",
        "eden_get_suggested_connections",
        "eden_search_highlights",
        "eden_list_highlights",
        "eden_create_note",
        "eden_append_to_note",
        "eden_create_sticky_note",
        "eden_create_board",
        "eden_save_links_to_board",
        "eden_save_posts_to_board",
        "eden_connect_items"
      ]
    }
  ],
  "setup_tools": [
    "eden_list_workspaces"
  ],
  "resource_scope": {
    "kind": "single_workspace",
    "discovery_tool": "eden_list_workspaces",
    "id_field": "id",
    "label_field": "name",
    "argument": "workspaceId"
  },
  "budgets": {
    "agent_turn_calls": 20,
    "agent_turn_paginated_calls": 5
  },
  "result_contract": {
    "kind": "json_boolean",
    "success_field": "ok",
    "status_field": "status",
    "message_field": "message"
  },
  "tools": [
    {
      "name": "eden_list_workspaces",
      "description": "List Eden workspaces available to the connected token.",
      "policy_class": "external_api",
      "read_only": true,
      "replay_safe": false,
      "required_credential_scope": "read",
      "rail": "mcp",
      "collection_policy": null,
      "argument_guards": [],
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {},
        "type": "object"
      },
      "output_schema": null,
      "upstream_annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "descriptor_sha256": "717f9fff74ee86e72fb172cffa9ad799b9ff3c4ceee1e45c91c00f9d467d4e7c"
    },
    {
      "name": "eden_list_workspace_items",
      "description": "Browse saved workspace items with bounded pagination.",
      "policy_class": "external_api",
      "read_only": true,
      "replay_safe": true,
      "required_credential_scope": "read",
      "rail": "mcp",
      "collection_policy": {
        "paginated": true,
        "request_limit_pointer": "/limit",
        "default_limit": 50,
        "result_items_pointer": "/items",
        "max_returned_items": 50
      },
      "argument_guards": [],
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "cursor": {
            "description": "Opaque pagination cursor. Pass the previous response's `nextCursor` verbatim to fetch the next page. Omit on the first call.",
            "maxLength": 64,
            "type": "string"
          },
          "limit": {
            "description": "Max items per page. Defaults to 200. Server caps at 500 \u2014 never request more, the response will be silently truncated.",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "parentId": {
            "description": "Restrict to items whose parent is this board id. Cheaper than listing the workspace and filtering locally. Pass the workspace id to list workspace-root children only.",
            "maxLength": 128,
            "type": "string"
          },
          "type": {
            "description": "Optional `type` filter (e.g. `markdown`, `canvas`, `twitter`, `youtube`, `image`). Server-side, so it doesn't burn prompt tokens. Pair with pagination for tight pulls.",
            "maxLength": 64,
            "type": "string"
          },
          "workspaceId": {
            "description": "Workspace id from `eden_list_workspaces`. Optional when EDEN_WORKSPACE_ID is configured.",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "output_schema": null,
      "upstream_annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "descriptor_sha256": "a3138a7337379132780ae7e8e3df529e1ad76838c2c573ad7752377157272aa3"
    },
    {
