            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/dx/warranty/details",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/dx/warranty/details"
        },
        "query": {
          "vin": "{vin}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "activeWarranty",
            "upcomingWarranty",
            "expiredWarranty"
          ]
        }
      }
    },
    {
      "name": "tesla_wake_vehicle",
      "description": "Wake a sleeping car (billed; harmless if awake). Then re-check status. Args: vin.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "vehicle_device_data",
        "vehicle_cmds"
      ],
      "requires_setting": "ALLOW_COMMANDS",
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
