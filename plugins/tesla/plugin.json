{
  "schema_version": 2,
  "name": "tesla",
  "display_name": "Tesla",
  "description": "Check your Tesla's charge, climate, location, alerts and history, and control charging, climate and locks.",
  "category": "productivity",
  "version": "1.1.0",
  "default_enabled": false,
  "interface": {
    "short_description": "See your Tesla's state, and control it when you allow commands",
    "developer_name": "Fermix",
    "brand_color": "#E82127",
    "logo": "assets/logo.png",
    "privacy_policy_url": "https://www.tesla.com/legal/privacy",
    "terms_of_service_url": "https://www.tesla.com/legal"
  },
  "auth": {
    "type": "oauth2",
    "provider": "tesla",
    "scopes": [
      "openid",
      "offline_access",
      "vehicle_device_data",
      "vehicle_location",
      "vehicle_charging_cmds",
      "vehicle_cmds"
    ]
  },
  "runtime": {
    "kind": "binary",
    "command": "fermix-tesla",
    "vendored": true,
    "requires_setting": "ALLOW_COMMANDS"
  },
  "config": [
    {
      "key": "ALLOW_COMMANDS",
      "prompt": "Allow vehicle commands",
      "required": false,
      "kind": "boolean"
    },
    {
      "key": "SIGNING_KEY_PATH",
      "prompt": "Signing key path",
      "required": false,
      "kind": "text"
    }
  ],
  "tools": [
    {
      "name": "tesla_list_vehicles",
      "description": "List cars: vin, display_name, cloud state. Cloud read. Args: none.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "vin",
            "display_name",
            "state",
            "in_service",
            "access_type",
            "vehicle_id",
            "api_version",
            "calendar_enabled"
          ]
        }
      }
    },
    {
      "name": "tesla_get_vehicle_status",
      "description": "Cloud state of one car: online, asleep, offline. Never wakes it. Args: vin.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "vin",
            "display_name",
            "state",
            "in_service",
            "access_type",
            "api_version",
            "vehicle_id"
          ]
        }
      }
    },
    {
      "name": "tesla_get_vehicle_data",
      "description": "One live section from the car (billed; 408 when asleep). Args: vin, section.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          },
          "section": {
            "type": "string",
            "enum": [
              "charge_state",
              "climate_state",
              "vehicle_state",
              "vehicle_config",
              "closures_state",
              "gui_settings",
              "charge_schedule_data",
              "preconditioning_schedule_data"
            ],
            "description": "One section per call: charge_state for battery, range and charging; climate_state for temperatures; vehicle_state for odometer, locks, tyres, software and sentry; vehicle_config for trim; closures_state for doors, windows and trunks; gui_settings for the car's display units; charge_schedule_data and preconditioning_schedule_data for schedules."
          }
        },
        "required": [
          "vin",
          "section"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/vehicle_data",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/vehicle_data"
        },
        "query": {
          "endpoints": "{section}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "vin",
            "state",
            "charge_state",
            "climate_state",
            "vehicle_state",
            "vehicle_config",
            "closures_state",
            "gui_settings",
            "charge_schedule_data",
            "preconditioning_schedule_data"
          ]
        }
      }
    },
    {
      "name": "tesla_get_vehicle_location",
      "description": "Live GPS position (billed; shows a sharing icon in the car). Args: vin.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data",
        "vehicle_location"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/vehicle_data",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/vehicle_data"
        },
        "query": {
          "endpoints": "location_data"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response.drive_state",
          "fields": [
            "latitude",
            "longitude",
            "heading",
            "speed",
            "power",
            "shift_state",
            "gps_as_of",
            "timestamp",
            "native_location_supported"
          ]
        }
      }
    },
    {
      "name": "tesla_get_fleet_status",
      "description": "Firmware, command-protocol need, key pairing, telemetry version. Args: vin.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "POST",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/fleet_status",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/fleet_status"
        },
        "body": {
          "vins": [
            "{vin}"
          ]
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "key_paired_vins",
            "unpaired_vins",
            "vehicle_info"
          ]
        }
      }
    },
    {
      "name": "tesla_get_mobile_access",
      "description": "Whether the car's Allow Mobile Access setting is on. Args: vin.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_cmds"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/mobile_enabled",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/mobile_enabled"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "result",
            "reason"
          ]
        }
      }
    },
    {
      "name": "tesla_get_vehicle_alerts",
      "description": "Recent alerts with times and any owner text. Cloud read. Args: vin.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/recent_alerts",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/recent_alerts"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response.recent_alerts",
          "fields": [
            "name",
            "time",
            "audience",
            "user_text"
          ]
        }
      }
    },
    {
      "name": "tesla_get_service_status",
      "description": "Service state, estimated completion, visit number. Cloud read. Args: vin.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/service_data",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/service_data"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "service_status",
            "service_etc",
            "service_visit_number",
            "status_id"
          ]
        }
      }
    },
    {
      "name": "tesla_get_release_notes",
      "description": "Software release notes, installed or staged. Args: vin, staged (bool).",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          },
          "staged": {
            "type": "boolean",
            "default": false,
            "description": "true returns notes for a staged update that is downloaded but not installed."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/release_notes",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/release_notes"
        },
        "query": {
          "staged": "{staged}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response"
        }
      }
    },
    {
      "name": "tesla_get_nearby_charging_sites",
      "description": "Chargers near the car (billed; car must be online). Args: vin, count, radius.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          },
          "count": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 25,
            "description": "Sites of each kind to return, 1-25. Keep small unless the user asks for more."
          },
          "radius": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 200,
            "description": "Search radius in miles, 1-200."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/nearby_charging_sites",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/nearby_charging_sites"
        },
        "query": {
          "count": "{count}",
          "radius": "{radius}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "superchargers",
            "destination_charging",
            "timestamp"
          ]
        }
      }
    },
    {
      "name": "tesla_list_charging_history",
      "description": "Tesla-billed charging sessions with fees. Args: vin, start_time, end_time, page_no, page_size.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_charging_cmds"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          },
          "start_time": {
            "type": "string",
            "description": "Start of the window, ISO-8601 with offset, e.g. 2026-08-01T00:00:00-07:00."
          },
          "end_time": {
            "type": "string",
            "description": "End of the window, ISO-8601 with offset, e.g. 2026-09-01T00:00:00-07:00."
          },
          "page_no": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "description": "Page to fetch, from 1. Page only when the user asks for more."
          },
          "page_size": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 50,
            "description": "Sessions per page, 1-50."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/dx/charging/history",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/dx/charging/history"
        },
        "query": {
          "vin": "{vin}",
          "startTime": "{start_time}",
          "endTime": "{end_time}",
          "pageNo": "{page_no}",
          "pageSize": "{page_size}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response.data",
          "fields": [
            "sessionId",
            "vin",
            "siteLocationName",
            "chargeStartDateTime",
            "chargeStopDateTime",
            "unlatchDateTime",
            "countryCode",
            "fees",
            "billingType",
            "vehicleMakeType"
          ]
        }
      }
    },
    {
