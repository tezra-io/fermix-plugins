        ]
      },
      "request": {
        "method": "POST",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/wake_up",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/wake_up"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "vin",
            "state"
          ]
        }
      }
    },
    {
      "name": "tesla_navigate_to",
      "description": "Send a destination to the car's navigation. Args: vin, latitude, longitude.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "vehicle_cmds"
      ],
      "requires_setting": "ALLOW_COMMANDS",
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Destination latitude in decimal degrees."
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Destination longitude in decimal degrees."
          }
        },
        "required": [
          "vin",
          "latitude",
          "longitude"
        ]
      },
      "request": {
        "method": "POST",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/command/navigation_gps_request",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/command/navigation_gps_request"
        },
        "body": {
          "lat": "{latitude}",
          "lon": "{longitude}",
          "order": 0
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "result",
            "reason"
          ]
        }
      }
    },
    {
      "name": "tesla_send_navigation",
      "description": "Send a full street address to the car's nav. Args: vin, destination, locale, timestamp_ms.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "vehicle_cmds"
      ],
      "requires_setting": "ALLOW_COMMANDS",
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "description": "A full street address with city and region; the place name may lead it, e.g. Blue Bottle Coffee, 300 Webster St, Oakland, CA 94607. A Google Maps share link works only when the user pasted it. Never a bare place name or a link you composed: the car cannot resolve them and still reports success."
          },
          "locale": {
            "type": "string",
            "default": "en-US",
            "description": "Locale the car reads the destination in, e.g. en-US or de-DE."
          },
          "timestamp_ms": {
            "type": "string",
            "description": "The current time in epoch milliseconds, as a string, e.g. 1789459200000. Supply the time of the call."
          }
        },
        "required": [
          "vin",
          "destination",
          "timestamp_ms"
        ]
      },
      "request": {
        "method": "POST",
        "regional_urls": {
