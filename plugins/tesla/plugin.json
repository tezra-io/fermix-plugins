          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/dx/vehicles/options",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/dx/vehicles/options"
        },
        "query": {
          "vin": "{vin}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response.codes",
          "fields": [
            "code",
            "displayName",
            "isActive",
            "colorCode"
          ]
        }
      }
    },
    {
      "name": "tesla_get_warranty",
      "description": "Warranty cover for the car: active, upcoming, and expired terms.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "vehicle_device_data"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "GET",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/dx/warranty/details",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/dx/warranty/details"
        },
        "query": {
          "vin": "{vin}"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "activeWarranty",
            "upcomingWarranty",
            "expiredWarranty"
          ]
        }
      }
    },
    {
      "name": "tesla_wake_vehicle",
      "description": "Wake a sleeping car. Billed ($0.02), 3 per minute; re-check status after. Ask first.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "vehicle_device_data",
        "vehicle_cmds"
      ],
      "requires_setting": "ALLOW_COMMANDS",
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          }
        },
        "required": [
          "vin"
        ]
      },
      "request": {
        "method": "POST",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/wake_up",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/wake_up"
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "vin",
            "state"
          ]
        }
      }
    },
    {
      "name": "tesla_navigate_to",
      "description": "Send a destination to the car's navigation by coordinates.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "vehicle_cmds"
      ],
      "requires_setting": "ALLOW_COMMANDS",
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string",
            "minLength": 17,
            "maxLength": 17,
            "description": "17-character VIN from tesla_list_vehicles."
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Destination latitude in decimal degrees."
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Destination longitude in decimal degrees."
          }
        },
        "required": [
          "vin",
          "latitude",
          "longitude"
        ]
      },
      "request": {
        "method": "POST",
        "regional_urls": {
          "na": "https://fleet-api.prd.na.vn.cloud.tesla.com/api/1/vehicles/{vin}/command/navigation_gps_request",
          "eu": "https://fleet-api.prd.eu.vn.cloud.tesla.com/api/1/vehicles/{vin}/command/navigation_gps_request"
        },
        "body": {
          "lat": "{latitude}",
          "lon": "{longitude}",
          "order": 0
        },
        "success": [
          200
        ],
        "extract": {
          "path": "response",
          "fields": [
            "result",
            "reason"
          ]
        }
      }
    },
