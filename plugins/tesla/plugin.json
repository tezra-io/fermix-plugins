    {
      "name": "tesla_set_charge_limit",
      "description": "Set the charge limit as a percent of full.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "vehicle_cmds",
        "vehicle_charging_cmds"
